{
  "name": "77system-boilerplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.typecheck.json",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:migrate:test": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script",
    "db:seed": "tsx prisma/seed.ts",
    "contracts:validate": "tsx scripts/contracts-validate.ts",
    "rbac:integrity": "tsx scripts/rbac-integrity.ts",
    "routes:integrity": "tsx scripts/routes-integrity.ts",
    "seed:integrity": "tsx scripts/seed-integrity.ts",
    "data:worker": "tsx scripts/data-worker.ts",
    "docker:health": "tsx scripts/docker-health.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integrity": "pnpm typecheck && pnpm lint && pnpm db:validate && pnpm db:migrate:test && pnpm contracts:validate && pnpm rbac:integrity && pnpm routes:integrity && pnpm seed:integrity && pnpm test"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@prisma/client": "^6.13.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.4.4",
    "next-auth": "^5.0.0-beta.29",
    "nodemailer": "^9.0.3",
    "prisma": "^6.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^2.6.0",
    "tsx": "^4.20.3",
    "xlsx": "^0.18.5",
    "yaml": "^2.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.14",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.4.4",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "packageManager": "pnpm@9.15.4"
}
